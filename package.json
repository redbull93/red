{
  "name": "red",
  "private": true,
  "description": "StandUp Agent — Slack/Discord daily stand-up that cross-references blockers.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=control-plane",
    "dev:slack": "npm run dev --workspace=@red/slack-adapter",
    "dev:discord": "npm run dev --workspace=@red/discord-adapter",
    "build": "npm run build --workspace=control-plane",
    "mcp": "npm run start --workspace=@red/mcp-tools",
    "loop": "npm run demo --workspace=@red/orchestrator --",
    "loop:fail": "npm run demo --workspace=@red/orchestrator -- --fail",
    "loop:hitl": "npm run demo --workspace=@red/orchestrator -- --hitl",
    "test:exa": "npm run test --workspace=@red/mcp-tools"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@trigger.dev/sdk": "^4.0.0"
  }
}
