# Copy to .env.local at the REPO ROOT (the orchestrator, scripts and Trigger.dev
# tasks all read it from there). Empty keys fall back to honest stubs.
# Never commit secrets.

# ── Agent Router: the three-model council ─────────────────────────
# Primary gateway. Wins over a direct OpenAI key when both are set.
AGENT_ROUTER_API_KEY=
AGENT_ROUTER_BASE_URL=https://agentrouter.org
# Announced full-parity mirror, used as failover.
AGENT_ROUTER_FALLBACK_BASE_URL=https://ps.air-outer.com
# Agent Router fingerprints clients and returns 401 "unauthorized client
# detected" to anything that is not a supported harness. Leave this alone
# unless you know the gateway accepts your agent string.
AGENT_ROUTER_USER_AGENT=claude-cli/1.0.83 (external, cli)
AGENT_ROUTER_TIMEOUT_MS=90000

# Council seats. GPT and Opus are rationed daily (03:00/11:00/19:00 Nairobi)
# and return 402 once a batch drains; DeepSeek is not rationed.
ROUTER_MODEL_GPT=gpt-6-astra
ROUTER_MODEL_OPUS=claude-opus-4-8
ROUTER_MODEL_DEEPSEEK=deepseek-v4-flash
# Which seat drives the tool loop. DeepSeek by default because it stays up.
ROUTER_DRIVER_SEAT=deepseek

# Council behaviour — see prompts/council.md
# COUNCIL_ENABLED=1
# COUNCIL_SEATS=gpt,opus,deepseek
# COUNCIL_MIN_QUORUM=2
# COUNCIL_HITL_ON_UNVERIFIED=0
# COUNCIL_REPLAY=1

# ── Ambiguous workspace — see docs/06-ambiguous-setup.md ──────────
AMBIGUOUS_API_KEY=
AMBIGUOUS_BASE_URL=https://app.ambiguous.ai
# npx ambiguous chat channels list --json
AMBIGUOUS_STANDUP_CHANNEL=
AMBIGUOUS_STANDUP_DOC_TITLE=Stand-up log

# ── Legacy / direct providers (optional fallback) ─────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Live web search for the search.web MCP tool (blocker enrichment)
EXA_API_KEY=

# Slack adapter (environment home)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_STANDUP_CHANNEL=
SLACK_TEAM_ID=

# Discord adapter (second front door)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_STANDUP_CHANNEL=

# Persist daily responses to Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub integration for PR reality checks
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Durable morning schedule — swap jobs.ts for Trigger.dev
TRIGGER_SECRET_KEY=
# TRIGGER_API_KEY=

# Auth0 Integration (Authentication, HITL RBAC & Multi-Tenancy)
AUTH0_SECRET=use_a_32_character_long_secret_here
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_AUDIENCE=https://api.red.dev
AUTH0_ORGANIZATION_ID=

# CopilotKit & Other Integrations
# COPILOTKIT_API_KEY=
