# Copy to .env.local in apps/control-plane, or export in the shell.
# Empty keys fall back to honest stubs. Never commit secrets.

# Primary model (OpenAI) or failover gateway
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Live web search for the search.web MCP tool (blocker enrichment)
EXA_API_KEY=

# Slack adapter (environment home)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_STANDUP_CHANNEL=
SLACK_TEAM_ID=

# Discord adapter (second front door)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_STANDUP_CHANNEL=

# Persist daily responses (optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Durable morning schedule — swap jobs.ts for Trigger.dev
TRIGGER_SECRET_KEY=
# TRIGGER_API_KEY=

# Optional day-of sponsors
# AUTH0_SECRET=
# AUTH0_BASE_URL=
# COPILOTKIT_API_KEY=
