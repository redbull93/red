# Copy to .env.local in apps/control-plane, or export in the shell.
# Empty keys fall back to honest stubs. Never commit secrets.

# Primary model (OpenAI) or failover gateway
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Live web search for search.web (Exa /search + highlights). Get a key at https://dashboard.exa.ai
EXA_API_KEY=

# Slack adapter (environment home)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_STANDUP_CHANNEL=
# Optional. Empty = DM humans in the channel where /standup is run.
SLACK_TEAM_USER_IDS=
# Other companies: OAuth install (Manage Distribution). Redirect http://localhost:3002/slack/oauth_redirect
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_STATE_SECRET=
SLACK_TEAM_ID=
SLACK_OAUTH_PORT=3002
STANDUP_WEBHOOK_SECRET=
STANDUP_START_URL=http://localhost:3001/internal/standup/start
PORT=3001

# Discord adapter (second front door)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_STANDUP_CHANNEL=

# Persist daily responses to Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub integration for PR reality checks
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Durable morning schedule — swap jobs.ts for Trigger.dev
TRIGGER_SECRET_KEY=
# TRIGGER_API_KEY=

# Auth0 Integration (Authentication, HITL RBAC & Multi-Tenancy)
AUTH0_SECRET=use_a_32_character_long_secret_here
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_AUDIENCE=https://api.red.dev
AUTH0_ORGANIZATION_ID=

# Optional: Ambiguous AI workspace tasks (standup follow-ups)
AMBIGUOUS_API_KEY=

# CopilotKit & Other Integrations
# COPILOTKIT_API_KEY=
