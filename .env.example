# Copy to .env.local in apps/control-plane, or export in the shell.
# Empty keys fall back to honest stubs. Never commit secrets.

# Primary model (OpenAI) or failover gateway
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Live web search for search.web (Exa /search + highlights). Get a key at https://dashboard.exa.ai
EXA_API_KEY=

# Slack adapter (environment home)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_STANDUP_CHANNEL=
# Optional. Empty = DM humans in the channel where /standup is run.
SLACK_TEAM_USER_IDS=
# Other companies: OAuth install (Manage Distribution). Redirect http://localhost:3002/slack/oauth_redirect
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_STATE_SECRET=
SLACK_TEAM_ID=
SLACK_OAUTH_PORT=3002
STANDUP_WEBHOOK_SECRET=
STANDUP_START_URL=http://localhost:3001/internal/standup/start
PORT=3001

# Discord adapter (second front door)
DISCORD_BOT_TOKEN=
DISCORD_STANDUP_CHANNEL=

# Persist daily responses (optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Durable morning schedule — swap jobs.ts for Trigger.dev
TRIGGER_SECRET_KEY=
# TRIGGER_API_KEY=

# Optional day-of sponsors
# AUTH0_SECRET=
# AUTH0_BASE_URL=
# COPILOTKIT_API_KEY=
